{
  "name": "bilibili-toy-starter",
  "version": "0.1.3",
  "private": true,
  "description": "Bilibili Toy starter — Vue 3 + UnoCSS + TypeScript, engineered with vite-plus",
  "homepage": "https://github.com/imba97/bilibili-toy-starter#readme",
  "bugs": {
    "url": "https://github.com/imba97/bilibili-toy-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imba97/bilibili-toy-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "staged": "vp staged",
    "sdk:pack": "pnpm --filter bilibili-toy run pack",
    "pack:zip": "npm run sdk:pack && vp build && esno scripts/pack.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vue-tsc.json",
    "hooks:install": "vp config --hooks && vp hooks enable",
    "hooks:status": "vp hooks status",
    "release": "bumpp -r",
    "toy:login": "toy login",
    "toy:mylist": "toy mylist --json",
    "toy:publish": "npm run sdk:pack && vp build && toy create ./dist --json",
    "toy:update": "npm run sdk:pack && vp build && toy update",
    "toy:stats": "toy stats",
    "toy:history": "toy history",
    "toy:bind": "toy video bind",
    "toy:unbind": "toy video unbind"
  },
  "dependencies": {
    "bilibili-toy": "workspace:*",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.27",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.3",
    "@unocss/reset": "^66.10.5",
    "@unocss/vite": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "archiver": "^8.0.0",
    "bumpp": "^12.3.0",
    "esno": "^4.8.0",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.4.2"
}
